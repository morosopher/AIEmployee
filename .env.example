# 基础运行环境与服务地址
APP_ENV=development
APP_TEST_MODE=false
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# M2 真实写入默认关闭；非生产白名单使用 JSON 数组与三段 canonical 身份键。
# 脱敏示例：google::synthetic-account、microsoft:synthetic-tenant:synthetic-graph-user。
# unreserved 字符保持原样，其他 opaque UTF-8 字节使用大写 %HH；不得填写邮箱或真实身份。
EXTERNAL_WRITES_ENABLED=false
GOOGLE_WRITES_ENABLED=false
MICROSOFT_WRITES_ENABLED=false
WRITE_TEST_ACCOUNT_ALLOWLIST=[]

# 生产部署必须提供不可变镜像标签和域名；禁止以 latest 作为发布或回滚依据。
APP_IMAGE_TAG=2026.08.05
APP_DOMAIN=localhost

# PostgreSQL、Checkpoint 与测试隔离配置
DATABASE_URL=postgresql+asyncpg://ai_employee:ai_employee@localhost:5432/ai_employee
CHECKPOINT_DATABASE_URL=postgresql://ai_employee:ai_employee@localhost:5432/ai_employee
TEST_DATABASE_URL=postgresql+asyncpg://ai_employee:ai_employee@localhost:5432/ai_employee_test
TEST_REDIS_URL=redis://localhost:6379/15
POSTGRES_USER=ai_employee
POSTGRES_PASSWORD=ai_employee
POSTGRES_DB=ai_employee
REDIS_URL=redis://localhost:6379/0

# Docker 生产部署从外部 Secret 挂载到 /run/secrets；本地 compose.dev 使用未提交文件。
POSTGRES_BOOTSTRAP_PASSWORD_FILE=./secrets/development/postgres_bootstrap_password
APP_DATABASE_PASSWORD_FILE=./secrets/development/app_database_password
RETENTION_DATABASE_PASSWORD_FILE=./secrets/development/retention_database_password
BACKUP_PASSPHRASE_FILE=./secrets/development/backup_passphrase
BACKUP_DIR=./var/backups
BACKUP_RCLONE_REMOTE=
# 普通备份保持空值；0019维护窗口必须指定安全basename，并把BACKUP_DIR改为已有绝对目录。
# CALENDAR_AAD_IMMUTABLE_IMAGE_ID由宿主recipe从Compose实际镜像解析，禁止手填或写入.env。
BACKUP_ARTIFACT_BASENAME=

# 长任务与会话边界
TASK_TIMEOUT_SECONDS=900
TASK_STEP_TIMEOUT_SECONDS=300
TASK_LEASE_SECONDS=360
OUTBOX_CLAIM_SECONDS=60
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_RELAY_BATCH_SIZE=100
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-employee
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
WORKER_METRICS_PORT=9101
SCHEDULER_METRICS_PORT=9102
RETENTION_DATABASE_URL_FILE=/run/secrets/retention_database_url
SESSION_COOKIE_NAME=ai_employee_session
SESSION_TTL_SECONDS=604800

# 密钥只记录容器内 Secret 文件路径，示例文件不承载任何真实凭据。
APP_MASTER_KEY_FILE=/run/secrets/app_master_key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET_FILE=/run/secrets/microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/connections/microsoft/callback

# 供应商无关的模型配置；密钥同样通过 Secret 文件注入。
MODEL_BASE_URL=
MODEL_API_KEY_FILE=/run/secrets/model_api_key
MODEL_NAME=
MODEL_SUPPORTS_JSON_SCHEMA=true
MODEL_INPUT_COST_PER_MILLION_USD=0
MODEL_OUTPUT_COST_PER_MILLION_USD=0
MODEL_REDACTION_PATTERNS=[]

# 用户工作上下文与每日简报默认值
WORK_EMAIL_DOMAINS=[]
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_BRIEF_TIME=08:00
