{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,
    "strict": true,
    // 只跳过第三方 .d.ts 的独立校验，项目源码仍按 strict 全量检查。@vueuse/core 15 的声明
    // 引用 TS 5.9 尚无的 Temporal 与未纳入 types 白名单的 Web Bluetooth 全局类型，
    // @testing-library/vue 8 的声明引用其未声明依赖的 type-fest，不跳过则无法通过。
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client", "vitest/globals"]
  },
  // components.d.ts 是 unplugin-vue-components 生成的自动导入登记表，已被 git 忽略；模板类型
  // 并不依赖它：PrimeVue 核心组件的 GlobalComponents 声明来自 `primevue/config`，PrimeVue
  // Forms 组件的来自 src/env.d.ts 对 `@primevue/forms` 的显式引用。include 在文件存在时顺带
  // 收录，全新检出尚未生成时不命中也不报错，因此不能改用必须存在的 files 或
  // `/// <reference path>`。
  "include": ["src/**/*.ts", "src/**/*.vue", "components.d.ts"]
}
